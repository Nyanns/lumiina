# ==============================================================================
# Lumiina Backend Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific credentials.
# All variables marked with [FAIL-FAST] are strictly validated on startup.
# ==============================================================================

# --- Application Server ---
PORT=8080
APP_BASE_URL=http://localhost:8080
# Comma-separated list of allowed origins for CORS credentials
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) [FAIL-FAST] ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_NAME=lumiina_db

# --- Redis Cache & Rate Limiting ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication [FAIL-FAST] ---
# Must be at least 32 characters for HMAC-SHA256 cryptographic security.
# Insecure default placeholders will cause immediate startup abort.
JWT_SECRET=replace_with_a_secure_random_key_at_least_32_characters_long

# --- Cloudinary Media Storage [FAIL-FAST] ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_SECRET=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- SMTP Email Dispatcher (Account Verification & Password Reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
